# ─────────────────────────────────────────────────────────────────────────────
# cs-agent — model endpoint configuration (example)
#
# cs-agent itself is DETERMINISTIC and needs NO model/API key to run:
#   design packs, KB Q&A, and PAC dry-run all work offline with zero deps.
#
# The variables below are for OTHER OpenAI-compatible consumers you point at
# local or cloud model endpoints (VS Code Copilot custom models, aimock mock
# server recording, your own coding agents). Copy this file to `.env` and
# fill in only the provider you use. Never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── Local OpenAI-compatible endpoint (vLLM / llama.cpp / Ollama / LM Studio) ─
# Example: a DeepSeek or Llama model served on your homelab / workstation.
CS_AGENT_LOCAL_BASE_URL=http://127.0.0.1:8000/v1
CS_AGENT_LOCAL_MODEL=your-model-name
CS_AGENT_LOCAL_API_KEY=local-key-optional

# ── GitHub Models (free Azure-hosted models via GitHub PAT) ──────────────────
# OpenAI-compatible. Use a fine-grained GitHub PAT (models:read) as the key.
CS_AGENT_GH_MODELS_BASE_URL=https://models.github.ai/inference
CS_AGENT_GH_MODELS_MODEL=gpt-4o-mini
CS_AGENT_GH_MODELS_API_KEY=${GITHUB_TOKEN}

# ── Azure OpenAI ─────────────────────────────────────────────────────────────
# base_url points at your resource + deployment + api-version. Auth: api-key header.
CS_AGENT_AZURE_OPENAI_BASE_URL=https://YOUR_RESOURCE.openai.azure.com/openai/v1
CS_AGENT_AZURE_OPENAI_MODEL=YOUR_DEPLOYMENT_NAME
CS_AGENT_AZURE_OPENAI_API_KEY=${AZURE_OPENAI_KEY}

# ── Azure AI Foundry (model inference) ───────────────────────────────────────
# base_url points at the Foundry models endpoint (Chat Completions path).
CS_AGENT_AI_FOUNDRY_BASE_URL=https://YOUR_PROJECT.services.ai.azure.com/models
CS_AGENT_AI_FOUNDRY_MODEL=gpt-4o-mini
CS_AGENT_AI_FOUNDRY_API_KEY=${AZURE_AI_FOUNDRY_KEY}
